# Copia este archivo como ".env" y completa los valores. El archivo .env NUNCA se sube a GitHub.

NODE_ENV=development
PORT=4000

# Orígenes permitidos (frontend), separados por coma
CORS_ORIGINS=http://localhost:4200,https://iyt.netlify.app
# URL del frontend (para el enlace de "olvidé mi contraseña")
FRONTEND_URL=http://localhost:4200

# ---------- Base de datos MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_node
DB_PASSWORD=cambia_esta_clave
DB_NAME=bdd_campeonatos_v02
# true si la conexión a MySQL usa SSL (por ejemplo desde Render hacia Contabo)
DB_SSL=false

# ---------- Sesión ----------
# Clave larga y aleatoria (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon_aqui_una_clave_larga_y_aleatoria_de_al_menos_32_caracteres
# Tiempo de inactividad antes de pedir login otra vez (req. 3.3.2)
JWT_EXPIRES=30m

# ---------- Servidor de archivos ----------
# local = carpeta "uploads" (solo desarrollo) | s3 = servidor de archivos compatible con S3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
MAX_UPLOAD_MB=10
# Si STORAGE_DRIVER=s3:
S3_ENDPOINT=https://archivos.tudominio.com
S3_REGION=us-east-1
S3_BUCKET=iyt-archivos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---------- Correo (recuperar contraseña) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# En Gmail usar una "contraseña de aplicación", no la contraseña normal
SMTP_PASS=
SMTP_FROM="Integración Yaretanense <tu_correo@gmail.com>"
